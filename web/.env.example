DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string-32chars-min"
# Limit wywołań LLM na dobę (domyślnie 200)
AI_DAILY_LIMIT=200
# Opcjonalny webhook przy nowej fiszce
# WEBHOOK_URL=https://example.com/hooks/szczep
# Wyszukiwanie semantyczne (POST /api/szukaj) — klucz service role tylko po stronie serwera
# SUPABASE_URL=https://twoj-projekt.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Opcjonalnie — bez kluczy działa tryb szablonowy:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Czat w POST /api/warianty (darmowy limit Groq, bez karty)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
